# ==============================================================================
# DevBox VM Host Inventory Record
# Host: {{ VMHOST_NAME }}
# Generated: {{ GENERATED_AT }}
# ==============================================================================
vmhost:
  name: "{{ VMHOST_NAME }}"
  alias: "{{ VMHOST_ALIAS }}"
  connection:
    type: "{{ CONNECTION_TYPE }}"
    host: "{{ SSH_HOST }}"
    port: {{ SSH_PORT }}
    user: "{{ SSH_USER }}"
  system:
    hostname: "{{ HOSTNAME }}"
    fqdn: "{{ FQDN }}"
    os:
      distribution: "{{ OS_DISTRO }}"
      version: "{{ OS_VERSION }}"
      pretty_name: "{{ OS_PRETTY_NAME }}"
      kernel: "{{ KERNEL_VERSION }}"
      architecture: "{{ ARCHITECTURE }}"
    uptime: "{{ UPTIME }}"
  hardware:
    cpu:
      model: "{{ CPU_MODEL }}"
      vendor: "{{ CPU_VENDOR }}"
      sockets: {{ CPU_SOCKETS }}
      cores_per_socket: {{ CPU_CORES_PER_SOCKET }}
      threads_per_core: {{ CPU_THREADS_PER_CORE }}
      total_cores: {{ CPU_TOTAL_CORES }}
      virtualization:
        hardware_vt: {{ HARDWARE_VT_ENABLED }}
        flags: "{{ CPU_VT_FLAGS }}"
        kvm_device_present: {{ KVM_DEVICE_PRESENT }}
    memory:
      total_mib: {{ MEMORY_TOTAL_MIB }}
      total_gb: {{ MEMORY_TOTAL_GB }}
      free_mib: {{ MEMORY_FREE_MIB }}
      available_mib: {{ MEMORY_AVAILABLE_MIB }}
    storage:
      root_filesystem:
        device: "{{ ROOT_FS_DEVICE }}"
        mount: "{{ ROOT_FS_MOUNT }}"
        total_gb: {{ ROOT_FS_TOTAL_GB }}
        available_gb: {{ ROOT_FS_AVAILABLE_GB }}
        percent_used: "{{ ROOT_FS_PERCENT_USED }}"
      pools:
{{ STORAGE_POOLS_YAML }}
  virtualization:
    hypervisor:
      type: "{{ HYPERVISOR_TYPE }}"
      daemon: "{{ LIBVIRT_DAEMON_STATUS }}"
      libvirt_version: "{{ LIBVIRT_VERSION }}"
      qemu_version: "{{ QEMU_VERSION }}"
    networks:
{{ NETWORKS_YAML }}
  vms:
    count: {{ VM_COUNT }}
    running_count: {{ VM_RUNNING_COUNT }}
    domains:
{{ VM_LIST_YAML }}
  inventory:
    record_path: "inventory/{{ VMHOST_NAME }}/vmhost.yaml"
    vms_directory: "inventory/{{ VMHOST_NAME }}/"
    status: "{{ INVENTORY_STATUS }}"
